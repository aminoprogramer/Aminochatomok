# ============================================
# ⭐ Mokalmat Chat — .gitignore
# ============================================

# ⭐⭐⭐ أسرار — CRITICAL
.env
.env.*
!.env.example

# ⭐⭐⭐ Dependencies
node_modules/
package-lock.json

# ⭐⭐⭐ Uploads
uploads/
!uploads/.gitkeep

# ⭐⭐⭐ Backups
backup-*/
migration-backup/
*.backup

# ⭐⭐⭐ Logs
*.log
logs/
pm2-*.log

# ⭐⭐⭐ OS
.DS_Store
Thumbs.db

# ⭐⭐⭐ IDE
.vscode/
.idea/
*.swp

# ⭐⭐⭐ Old versions
*.OLD
*.old

# ⭐⭐⭐ Node
npm-debug.log*
yarn-error.log*

